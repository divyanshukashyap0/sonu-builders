rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is an admin
    function isAdmin() {
      return request.auth != null && 
             exists(/databases/$(database)/documents/admins/$(request.auth.token.email)) &&
             get(/databases/$(database)/documents/admins/$(request.auth.token.email)).data.role == 'admin';
    }
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // ========================================
    // ADMINS COLLECTION
    // ========================================
    match /admins/{email} {
      // Anyone authenticated can read their own admin status
      allow read: if isAuthenticated() && request.auth.token.email == email;
      
      // Only existing admins can read all admin documents
      allow list: if isAdmin();
      
      // Auto-registration: new users can create their own pending entry
      allow create: if isAuthenticated() && 
                       request.auth.token.email == email &&
                       request.resource.data.role == 'pending' &&
                       request.resource.data.email == email;
      
      // Only admins can update/delete (approve, reject, revoke)
      allow update, delete: if isAdmin();
    }
    
    // ========================================
    // PROJECTS COLLECTION
    // ========================================
    match /projects/{projectId} {
      // Public read access
      allow read: if true;
      
      // Only admins can create, update, or delete
      allow create, update, delete: if isAdmin();
    }
    
    // ========================================
    // TESTIMONIALS COLLECTION
    // ========================================
    match /testimonials/{testimonialId} {
      // Public read access
      allow read: if true;
      
      // Only admins can create, update, or delete
      allow create, update, delete: if isAdmin();
    }
    
    // ========================================
    // GALLERY COLLECTION
    // ========================================
    match /gallery/{galleryId} {
      // Public read access
      allow read: if true;
      
      // Only admins can create, update, or delete
      allow create, update, delete: if isAdmin();
    }
    
    // ========================================
    // SERVICES COLLECTION
    // ========================================
    match /services/{serviceId} {
      // Public read access
      allow read: if true;
      
      // Only admins can create, update, or delete
      allow create, update, delete: if isAdmin();
    }

    // ========================================
    // SETTINGS COLLECTION
    // ========================================
    match /settings/{settingId} {
      // Public read access for general and social settings
      allow read: if true;
      
      // Only admins can create or update settings
      allow create, update: if isAdmin();
      
      // Prevent deletion of settings
      allow delete: if false;
    }
    
    // ========================================
    // LEADS COLLECTION (Contact Form Submissions)
    // ========================================
    match /leads/{leadId} {
      // Anyone can create a lead (contact form submission)
      allow create: if true;
      
      // Only admins can read, update, or delete leads
      allow read, update, delete: if isAdmin();
    }
    
    // ========================================
    // SITE CONTENT COLLECTION (Dynamic Content Management)
    // ========================================
    match /site_content/{sectionId} {
      // Public read access for all sections
      allow read: if true;
      
      // Only admins can create or update site content
      allow create, update: if isAdmin();
      
      // Prevent deletion of site content sections
      allow delete: if false;
    }
    
    // ========================================
    // NOTIFICATIONS COLLECTION
    // ========================================
    match /notifications/{notificationId} {
      // Public read access
      allow read: if true;
      
      // Only admins can create/manage notifications
      allow create, update, delete: if isAdmin();
    }

    // ========================================
    // ESTIMATES COLLECTION
    // ========================================
    match /estimates/{estimateId} {
      // Anyone can submit an estimate
      allow create: if true;
      
      // Only admins can read, update, or delete
      allow read, update, delete: if isAdmin();
    }

    // ========================================
    // CALL LOGS COLLECTION (Tracking)
    // ========================================
    match /call_logs/{logId} {
      // Anyone can log a call click
      allow create: if true;
      
      // Only admins can read or manage logs
      allow read, update, delete: if isAdmin();
    }
    
    // ========================================
    // CHAT INQUIRIES COLLECTION
    // ========================================
    match /chat_inquiries/{inquiryId} {
      // Anyone can submit a chat inquiry
      allow create: if true;
      
      // Only admins can read, update, or delete
      allow read, update, delete: if isAdmin();
    }
    
    // ========================================
    // MEDIA COLLECTION
    // ========================================
    match /media/{mediaId} {
      // Public read access for the library
      allow read: if true;
      
      // Only admins can upload or delete
      allow create, update, delete: if isAdmin();
    }

    // ========================================
    // DEFAULT DENY ALL
    // ========================================
    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
